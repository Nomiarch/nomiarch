  "api_version": "nomiarch.io/v1alpha1",
  "name": "onprem-lab",
  "target": "existing",
  "architecture": "amd64",
  "capacity": {"cpus": 2, "memory_gib": 8, "disk_gib": 40},
  "existing": {
